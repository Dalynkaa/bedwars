        <!--            <groupId>me.dalynkaa</groupId>-->
        <!--            <artifactId>PartyManager-api</artifactId>-->
        <!--            <version>1.0.0-SNAPSHOT</version>-->
        <!--            <scope>provided</scope>-->
        <!--        </dependency>-->
    </dependencies>
